{
  "name": "tripare-dog-breeds",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/native": "^7.5.1",
    "@react-navigation/native-stack": "^7.21.0",
    "@shopify/flash-list": "2.3.2",
    "expo": "~58.0.19",
    "expo-asset": "~58.0.18",
    "expo-font": "~58.0.10",
    "expo-image": "~58.0.17",
    "expo-linking": "~58.0.14",
    "expo-sqlite": "~58.0.14",
    "expo-status-bar": "~58.0.4",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-screens": "~4.30.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^58.0.4",
    "jest": "^30.5.2",
    "jest-expo": "^58.0.12",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "bundle:analyze": "rm -rf dist-analyze && expo export --platform ios --no-bytecode --source-maps --output-dir dist-analyze && cd dist-analyze/_expo/static/js/ios && npx --yes source-map-explorer@2.5.3 *.js *.js.map --no-border-checks --html ../../../../report.html"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "setupFiles": [
      "./jest.setup.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/.maestro/"
    ],
    "watchman": false
  }
}
