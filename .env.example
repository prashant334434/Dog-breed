# All variables are optional; defaults live in src/config.ts.
# Dog API v2 base URL (no key required)
EXPO_PUBLIC_DOG_API_BASE_URL=https://dogapi.dog/api/v2
# Breeds per page when assembling the dataset (283 records / 48 = 6 pages)
EXPO_PUBLIC_PAGE_SIZE=48
# Cached data older than this triggers a background sync on launch/foreground/reconnect
EXPO_PUBLIC_STALE_AFTER_MINUTES=360
# Image disk cache cap (iOS; Android uses Glide's built-in 250 MB LRU)
EXPO_PUBLIC_IMAGE_DISK_CACHE_MB=150
